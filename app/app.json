{
  "expo": {
    "name": "ibnIPS",
    "slug": "ibnips-mobile",
    "scheme": "ibnips",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.kiit.ibnips",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ibnIPS uses your location to read nearby Wi-Fi access points so it can work out which room you are in inside the campus.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ibnIPS uses your location to read nearby Wi-Fi access points so it can work out which room you are in inside the campus.",
        "NSLocalNetworkUsageDescription": "ibnIPS reads nearby Wi-Fi access points on your local network to determine your room.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "in.kiit.ibnips",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-wifi-reborn",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ibnIPS uses your location to read nearby Wi-Fi access points so it can work out which room you are in inside the campus."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
