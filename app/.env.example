# Base URL of the ibnIPS Gleam backend.
#
#   - Android emulator  -> http://10.0.2.2:3000  (host loopback)
#   - Genymotion         -> http://10.0.3.2:3000
#   - Physical device    -> http://<your-lan-ip>:3000  (same Wi-Fi as the backend)
#   - Laptop / web       -> http://localhost:3000
#
# The deployed instance is used by default so the app works with no setup.
EXPO_PUBLIC_API_BASE_URL=https://ibnips.onrender.com
