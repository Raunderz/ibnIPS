# Base URL of the ibnIPS Gleam backend.
#
#   - Android emulator  -> http://10.0.2.2:3000  (host loopback)
#   - Genymotion         -> http://10.0.3.2:3000
#   - Physical device    -> http://<your-lan-ip>:3000  (same Wi-Fi as the backend)
#   - Laptop / web       -> http://localhost:3000
#
# The deployed instance is used by default so the app works with no setup.
EXPO_PUBLIC_API_BASE_URL=https://ibnips.onrender.com

# Shared access key required by the backend on POST /api/auth.
#
# This is the server's AUTH_KEY from backend/.env. There is no default on
# purpose: anything baked into an APK can be read by anyone who unzips it, so
# the app asks for it instead of shipping one. On a device you can paste it into
# the Backend screen without a rebuild.
EXPO_PUBLIC_API_ACCESS_KEY=
