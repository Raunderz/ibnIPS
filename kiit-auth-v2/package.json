{
  "name": "kiit-auth",
  "version": "2.0.0",
  "description": "Google-verified identity and per-roll-number access codes for KIIT users",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot src/server.civet",
    "build": "bash scripts/check.sh",
    "typecheck": "civet --typecheck src/*.civet test/*.civet",
    "test": "bash scripts/check.sh && bun test build/test/",
    "check": "bash scripts/check.sh && civet --typecheck src/*.civet test/*.civet && bun test build/test/"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@danielx/civet": "0.11.16",
    "@types/node": "24.10.1",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}