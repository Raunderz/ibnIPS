# Copy to .env and fill in real values. Never commit .env.

# --- Database (Turso / libSQL) ---
# Both required. When absent every endpoint answers 503 and /healthz reports
# "not configured" rather than crashing, so a preview deploy without secrets
# still boots.
#
# The URL may be given as libsql://host or the newer libsql:host.
DATABASE_URL=
DATABASE_TOKEN=

# --- Google OAuth ---
# Web client ID. Must list this deployment's origin in the Google console.
# The server injects it into the login page, and verifies it as the expected
# audience on every ID token.
GOOGLE_CLIENT_ID=

# --- Tenant ---
# Bare domain permitted to authenticate, without the "@" or a scheme.
# Must have at least three labels, so "ac.in" is refused as too broad — it would
# admit every college under that suffix rather than one institution.
#
# A wrong-but-well-formed value like "kiit.ac.in.evil.test" is accepted verbatim
# and fails CLOSED: it locks everyone out rather than admitting anyone extra.
ALLOWED_DOMAIN=kiit.ac.in

# --- Access codes ---
# Entropy in bytes per code, 16-64. Output is base64url, so 24 bytes is a
# 32-character code.
ACCESS_CODE_BYTES=24

# --- Proxy ---
# Number of trusted reverse proxies in front of the app, 0-10.
#
# On Vercel this should be 1: the platform terminates TLS and forwards to the
# function, so x-forwarded-for is the only place a client address appears.
# Leaving it at 0 puts every caller in one shared rate-limit bucket, which
# throttles everyone together. Setting it higher than the real hop count lets
# a client spoof the header and choose its own bucket.
TRUST_PROXY=1

NODE_ENV=development
