# ibnIPS backend configuration
#
# Copy to .env and fill in:
#     cp .env.example .env
#
# The server reads these from the OS environment first, then from a .env file
# in the working directory. .env supports # comments and quoted values.
#
# .env is gitignored. Never commit real values.

# --- Required -------------------------------------------------------------

# Secret for signing JWTs. Minimum 32 characters, no placeholder values —
# the server refuses to start otherwise, because a key that exists in this
# repository would let anyone mint a valid token for any user.
#   openssl rand -hex 32
JWT_SECRET=

# Shared access key that clients send to POST /api/auth. Minimum 16 chars.
# This is what stops anyone claiming another user's account.
#   openssl rand -hex 16
AUTH_KEY=

# --- Database -------------------------------------------------------------

# Path to the SQLite file.
#
# Local: leave as icps.db. On Render set this to /tmp/icps.db, because the
# working directory is read-only there.
#
# WARNING: /tmp is wiped on every redeploy. Fingerprints collected since the
# last deploy are lost. A persistent disk is the fix — mount one and point
# DB_PATH at it, e.g. DB_PATH=/data/icps.db
DB_PATH=icps.db

# --- Optional -------------------------------------------------------------

# Listen port. Defaults to 3000.
# PORT=3000

# Remote URL for the map served by GET /api/map. Falls back to a local
# map.json when unset. map.json is gitignored, so set this in production.
# MAP_JSON_URL=

# --- Turso (not yet wired up) --------------------------------------------
#
# These are only needed once the backend talks to Turso instead of a local
# SQLite file. The code does not read them yet.
#
# Find both in the Turso dashboard for your database.
# DATABASE_URL=
# DATABASE_TOKEN=