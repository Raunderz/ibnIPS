<?xml version="1.0" encoding="utf-8"?>
<!--
  One review card, inflated once per response into the list in feedback.xml.
  Kept as its own layout rather than built in code so the padding and type
  sizes stay in one place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/review_card_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Name and stars on one line: name left, rating right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reviewUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/reviewStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#F9A825"
            android:textSize="13sp"
            android:singleLine="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/reviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#424242"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
