<?xml version="1.0" encoding="utf-8"?>
<!-- Purple, matching the accent used for the other secondary action, so the
     Reviews button reads as the odd one out rather than a fifth map control. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <gradient
        android:angle="270"
        android:startColor="#7B1FA2"
        android:endColor="#4A148C"
        android:type="linear" />
</shape>
