# Where the browser sends API requests.
#
# Leave EMPTY to use the Vite dev proxy (/__ibnips), which forwards to
# DEV_PROXY_TARGET from a same-origin server. This is the recommended setup:
# the real backend sends no Access-Control-* headers and answers preflight
# requests with 405, so a browser cannot call it cross-origin directly.
VITE_API_BASE_URL=

# Upstream the dev proxy forwards to.
DEV_PROXY_TARGET=https://ibnips.onrender.com

# Client request timeout in ms. A Render free instance sleeps after roughly
# 15 idle minutes and its cold start can take close to a minute, so keep this
# generous. Default is 30000.
# VITE_API_TIMEOUT_MS=45000
