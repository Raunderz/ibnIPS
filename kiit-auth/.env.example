# Copy to .env and fill in real values. Never commit .env.

# HTTP port the server listens on.
PORT=3000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/kiit-auth

# Google OAuth 2.0 Web client ID. Must match the client_id rendered into the
# login page, which the server injects from this value.
GOOGLE_CLIENT_ID=

# Bare domain permitted to authenticate, without the "@" or any scheme.
ALLOWED_DOMAIN=kiit.ac.in

# Entropy in bytes for generated API keys (>= 16).
API_KEY_BYTES=32

# Number of trusted reverse proxies in front of the app.
# 0 = none (direct connection), 1 = one nginx/load-balancer hop.
# Getting this wrong makes rate limiting either share one bucket across all
# users or trust spoofable client headers.
TRUST_PROXY=0

NODE_ENV=development
